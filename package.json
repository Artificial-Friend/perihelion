{
  "name": "perihelion",
  "version": "0.3.0",
  "description": "PERIHELION: hard sci-fi solar-system MMO in the browser (WebGPU + WebAssembly)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "typecheck": "tsc -p .",
    "serve": "cd dist && python3 -m http.server 8766",
    "test:shots": "node test/shots.js shots test/s1.js",
    "test:parity": "sh core/build.sh && node test/parity.mjs test/core-v3.wasm build/core.wasm 10000 --native build/core_native"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "prettier": "^3.9.10",
    "playwright-core": "^1.64.1",
    "esbuild": "^0.28.2"
  },
  "private": true
}
